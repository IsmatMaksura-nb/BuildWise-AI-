# =========================

# BuildWise-AI Environment Variables

# =========================

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

GROQ_VISION_MODEL=qwen/qwen3.6-27b

TAVILY_API_KEY=

HOST=127.0.0.1
